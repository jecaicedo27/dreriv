# ====================================
# BOT DERIV V2 - EXAMPLE ENVIRONMENT
# ====================================
# Copiar este archivo a .env y completar con tus valores reales

# DERIV API
DERIV_API_TOKEN=your_deriv_api_token_here
DERIV_APP_ID=12345
DERIV_ACCOUNT_TYPE=demo

# GROQ API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.05
GROQ_MAX_TOKENS=1500
GROQ_TIMEOUT_SECONDS=8

# POSTGRESQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=deriv_bot
DB_PASSWORD=change_this_password
DB_NAME=deriv_bot
DATABASE_URL=postgresql://deriv_bot:change_this_password@postgres:5432/deriv_bot

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# DASHBOARD
DASHBOARD_ADMIN_EMAIL=admin@example.com
DASHBOARD_ADMIN_PASSWORD=change_this_password
JWT_SECRET=generate_random_secret_here
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# RISK MANAGEMENT
KELLY_FRACTION=0.25
MAX_DAILY_LOSS_PCT=8.0
MAX_DRAWDOWN_PCT=25.0
MAX_CONCURRENT_TRADES=3
MAX_CORRELATED_TRADES=2
MAX_TRADES_PER_DAY=40
COOLDOWN_AFTER_LOSSES=3
COOLDOWN_MINUTES=15

# FEATURE FLAGS
USE_GROQ_LAYER2=false  # Enable AI meta-analysis layer (Layer 2)
ENABLE_PGVECTOR=false
ENABLE_AB_TESTING=true
ENABLE_DRAWDOWN_RECOVERY=true
ENABLE_GROQ_FALLBACK=true

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=/var/log/deriv-bot/bot.log

# SSL/DOMAIN
DOMAIN=bot.example.com
SSL_EMAIL=admin@example.com
